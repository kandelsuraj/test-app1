      "presentmentCurrencyRate": "1",
      "cart": {
        "lines": [
          {
            "quantity": 4500,
            "calculator": {
              "value": "{\"values\":{\"width\":100,\"height\":100},\"pieces\":1}"
            },
            "cost": {
              "amountPerQuantity": {
                "amount": "0.01"
              }
            },
            "merchandise": {
              "__typename": "ProductVariant",
              "product": {
                "title": "Panel",
                "calculator": {
                  "jsonValue": {
                    "formula": "width * height / 10000 * 45",
