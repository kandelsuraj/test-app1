                        "unit": "cm",
                        "min": 10,
                        "max": 300
                      },
                      {
                        "key": "height",
                        "label": "Height",
                        "type": "number",
                        "unit": "cm",
                        "min": 10,
                        "max": 300
                      }
                    ],
                    "maxPieces": 100
                  }
                }
              }
            }
          }
